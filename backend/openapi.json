{
  "components": {
    "schemas": {
      "AIVerdict": {
        "properties": {
          "quoted_code": {
            "title": "Quoted Code",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/AIVerdictLabel"
          }
        },
        "required": [
          "verdict",
          "reason",
          "quoted_code"
        ],
        "title": "AIVerdict",
        "type": "object"
      },
      "AIVerdictLabel": {
        "enum": [
          "confirmed",
          "likely_false_positive",
          "needs_review"
        ],
        "title": "AIVerdictLabel",
        "type": "string"
      },
      "AuditRun": {
        "properties": {
          "domain_verified": {
            "default": false,
            "title": "Domain Verified",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_guest": {
            "default": false,
            "title": "Is Guest",
            "type": "boolean"
          },
          "journey_steps": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Steps"
          },
          "live_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Live Url"
          },
          "previous_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Run Id"
          },
          "progress": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "integer"
          },
          "project_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Project Name",
            "type": "string"
          },
          "repo_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Url"
          },
          "risk_score": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "share_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Share Token"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/AuditRunStatus",
            "default": "queued"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "project_name",
          "repo_url",
          "live_url",
          "status",
          "progress",
          "verdict",
          "risk_score",
          "started_at",
          "finished_at",
          "error",
          "share_token",
          "is_guest",
          "journey_steps",
          "previous_run_id",
          "domain_verified"
        ],
        "title": "AuditRun",
        "type": "object"
      },
      "AuditRunStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "AuditRunStatus",
        "type": "string"
      },
      "Body_create_run_api_runs_post": {
        "properties": {
          "domain_token": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Token"
          },
          "journey_email": {
            "anyOf": [
              {
                "maxLength": 320,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Email"
          },
          "journey_password": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Password"
          },
          "live_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Live Url"
          },
          "project_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Project Name",
            "type": "string"
          },
          "repo_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Url"
          },
          "zip_file": {
            "anyOf": [
              {
                "contentMediaType": "application/octet-stream",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zip File"
          }
        },
        "required": [
          "project_name"
        ],
        "title": "Body_create_run_api_runs_post",
        "type": "object"
      },
      "Confidence": {
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "Confidence",
        "type": "string"
      },
      "ErrorCode": {
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "payload_too_large",
          "validation_error",
          "rate_limited",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "`{\"error\": {\"code\": ..., \"message\": ...}}`",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Evidence": {
        "description": "Engine-specific proof. Every key is optional (and may be omitted).",
        "properties": {
          "http": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HttpEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "package": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PackageEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "screenshot_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screenshot Url"
          },
          "secret_preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secret Preview"
          }
        },
        "title": "Evidence",
        "type": "object"
      },
      "Finding": {
        "properties": {
          "ai_verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AIVerdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "$ref": "#/components/schemas/FindingCategory"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "cwe": {
            "anyOf": [
              {
                "pattern": "^CWE-\\d+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe"
          },
          "end_line": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line"
          },
          "engine": {
            "$ref": "#/components/schemas/FindingEngine"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "fix_guidance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fix Guidance"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "rule_id": {
            "minLength": 1,
            "title": "Rule Id",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "snippet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snippet"
          },
          "start_line": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus",
            "default": "open"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "id",
          "rule_id",
          "engine",
          "category",
          "severity",
          "confidence",
          "cwe",
          "title",
          "file",
          "start_line",
          "end_line",
          "snippet",
          "trace",
          "evidence",
          "ai_verdict",
          "fix_guidance",
          "status"
        ],
        "title": "Finding",
        "type": "object"
      },
      "FindingCategory": {
        "enum": [
          "secrets",
          "injection",
          "auth",
          "access_control",
          "config",
          "dependency",
          "ssrf",
          "xss",
          "data_exposure",
          "other"
        ],
        "title": "FindingCategory",
        "type": "string"
      },
      "FindingEngine": {
        "enum": [
          "native",
          "semgrep",
          "gitleaks",
          "osv",
          "vibe",
          "live",
          "journey",
          "ai"
        ],
        "title": "FindingEngine",
        "type": "string"
      },
      "FindingStatus": {
        "enum": [
          "open",
          "fixed",
          "ignored",
          "false_positive"
        ],
        "title": "FindingStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HttpEvidence": {
        "properties": {
          "body_excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body Excerpt"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "request_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Request Headers",
            "type": "object"
          },
          "response_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Response Headers",
            "type": "object"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "method",
          "url",
          "status",
          "request_headers",
          "response_headers",
          "body_excerpt"
        ],
        "title": "HttpEvidence",
        "type": "object"
      },
      "JourneyStepView": {
        "description": "One journey step as shown on the report.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "screenshot_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screenshot Url"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "screenshot_url",
          "error"
        ],
        "title": "JourneyStepView",
        "type": "object"
      },
      "MeResponse": {
        "description": "The authenticated principal.",
        "properties": {
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "PackageEvidence": {
        "properties": {
          "advisory": {
            "title": "Advisory",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "advisory"
        ],
        "title": "PackageEvidence",
        "type": "object"
      },
      "ReportResponse": {
        "description": "Full report for one audit run, findings in fix-first order.",
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "journey_steps": {
            "items": {
              "$ref": "#/components/schemas/JourneyStepView"
            },
            "title": "Journey Steps",
            "type": "array"
          },
          "previous_risk_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Risk Score"
          },
          "resolved_findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Resolved Findings",
            "type": "array"
          },
          "run": {
            "$ref": "#/components/schemas/AuditRun"
          },
          "score_change": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Change"
          }
        },
        "required": [
          "run",
          "findings",
          "counts",
          "journey_steps",
          "previous_risk_score",
          "resolved_findings",
          "score_change"
        ],
        "title": "ReportResponse",
        "type": "object"
      },
      "RerunRequest": {
        "description": "Fresh per-run inputs for a rerun.\n\nJourney credentials are never persisted: a rerun copies only the\nproject name, repo URL and live URL from the original run, so the\ncaller supplies fresh credentials (and a fresh domain token) here.",
        "properties": {
          "domain_token": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Token"
          },
          "journey_email": {
            "anyOf": [
              {
                "maxLength": 320,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Email"
          },
          "journey_password": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journey Password"
          }
        },
        "title": "RerunRequest",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "title": "Severity",
        "type": "string"
      },
      "TraceStep": {
        "description": "One step of a data-flow trace from source to sink.",
        "properties": {
          "file": {
            "title": "File",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "line": {
            "minimum": 1.0,
            "title": "Line",
            "type": "integer"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          }
        },
        "required": [
          "file",
          "line",
          "snippet",
          "label"
        ],
        "title": "TraceStep",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Verdict": {
        "enum": [
          "launch",
          "fix_first",
          "do_not_launch"
        ],
        "title": "Verdict",
        "type": "string"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "`Authorization: Bearer <token>`",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "LaunchAudit API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/me": {
      "get": {
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Current principal",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Public liveness probe. Does not touch the database.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/reports/shared/{token}": {
      "get": {
        "operationId": "get_shared_report_api_reports_shared__token__get",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Full report by share token (public)",
        "tags": [
          "reports"
        ]
      }
    },
    "/api/runs": {
      "get": {
        "operationId": "list_runs_api_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuditRun"
                  },
                  "title": "Response List Runs Api Runs Get",
                  "type": "array"
                }
              }
            },
