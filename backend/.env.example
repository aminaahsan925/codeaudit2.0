# Copy to backend/.env for local development. Never commit .env.
# Read only by app/core/config.py.

# Required. Postgres via psycopg 3. SQLite (sqlite:///./data/launchaudit.db) is
# allowed when ENVIRONMENT is development or test; production requires Postgres.
DATABASE_URL=postgresql+psycopg://launchaudit:CHANGE_ME@localhost:5432/launchaudit

# Required (no default): development | test | production
ENVIRONMENT=development

# Comma-separated list of allowed browser origins. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum request body size in bytes (default 10 MiB, so zip uploads fit).
MAX_REQUEST_BYTES=10485760

# Directory for run artifacts (screenshots, PDFs). Default: backend/artifacts.
ARTIFACT_DIR=./artifacts

# Allow live checks and journey runs to target loopback/private addresses.
# Only ever true for local demos; must stay false in production.
ALLOW_LOOPBACK_LIVE_CHECKS=false

# AI review keys. Leave empty to use rule-based review. Gemini is tried first,
# then Groq.
GEMINI_API_KEY=
GROQ_API_KEY=

# Maximum audit runs per hour per user (default 10).
AUDIT_RATE_LIMIT_PER_HOUR=10

# Bearer token accepted by the development auth stub. Leave empty to reject all
# authenticated requests. When set it must be at least 32 characters, and it must
# not be set at all when ENVIRONMENT=production.
API_AUTH_TOKEN=

# Google sign-in. All three are optional; without them the app runs with guest
# runs and demo sign-in only. See docs/google-signin-setup.md for how to get
# these from Google Cloud. GOOGLE_REDIRECT_URI must match the Authorized
# redirect URI on the OAuth client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Signs session tokens. Required for any sign-in (Google or demo). When set it
# must be at least 32 characters; when empty, no session can be issued.
SESSION_SECRET=

# Public origin of the frontend, where the Google callback redirects after
# sign-in. Default http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
