# Copy to frontend/.env.local for local development. Never commit real .env files.
# Read only by src/lib/env.ts.
# NEXT_PUBLIC_* values are shipped to the browser: never put secrets here.

# Backend API origin. Defaults to http://localhost:8000 in development and test;
# required for production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
