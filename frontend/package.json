{
  "name": "launchaudit-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/types/api.ts",
    "gen:api:live": "openapi-typescript http://localhost:8000/api/openapi.json -o src/types/api.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "~5.108.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "~16.4.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "~1.65.1",
    "@tailwindcss/turbopack": "~4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "~16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "~7.13.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "vitest": "~5.1.1"
  }
}
