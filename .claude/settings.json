{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./.env.staging)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.test)",
      "Edit(./**/.env.staging)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.prod)",
      "Read(./**/.env.docker)",
      "Edit(./**/.env.dev)",
      "Edit(./**/.env.prod)",
      "Edit(./**/.env.docker)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm dlx:*)",
      "Bash(uv pip:*)",
      "Bash(uvx:*)"
    ],
    "allow": [
      "Read(./**/.env.example)",
      "Bash(pnpm:*)",
      "Bash(uv:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "default"
  }
}
